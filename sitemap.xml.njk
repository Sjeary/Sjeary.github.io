<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for post in posts %}
  <url>
    <loc>{{ post.permalink | uriencode | escape }}</loc>
    {% if post.updated %}<lastmod>{{ post.updated | formatDate }}</lastmod>{% endif %}
  </url>
  {% endfor %}
  <url>
    <loc>{{ config.url | uriencode | escape }}{{ config.index_generator.path | uriencode | escape }}/</loc>
  </url>
</urlset>
